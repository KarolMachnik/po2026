@startuml
left to right direction
skinparam packageStyle rectangle

actor "Dyspozytor MPK" as Dyspozytor
actor "Asystent AI" as Asystent
actor "Zegar symulacji" as Zegar

rectangle "DisKrak - symulator dyspozytorni MPK Kraków" {

    package "Sieć komunikacyjna" {
        usecase "Podejrzyj trasę linii" as UC_Preview
        usecase "Zbuduj przystanek na odcinku" as UC_BuildStop
        usecase "Utwórz linię" as UC_CreateRoute
        usecase "Utwórz linię zastępczą" as UC_CreateTempRoute
        usecase "Wyznacz przejezdną trasę" as UC_FindPath
    }

    package "Tabor i budżet" {
        usecase "Kup pojazd w sklepie taborowym" as UC_BuyVehicle
        usecase "Sprawdź stan budżetu" as UC_Budget
    }

    package "Kadry" {
        usecase "Zrekrutuj kierowcę" as UC_Recruit
        usecase "Przeglądaj kartę kierowcy MPK" as UC_DriverCard
        usecase "Rozlicz tachograf" as UC_Tachograph
    }

    package "Symulacja" {
        usecase "Zmień prędkość symulacji" as UC_Speed
        usecase "Wykonaj krok symulacji" as UC_Tick
        usecase "Obserwuj mapę na żywo" as UC_LiveMap
    }

    package "Wypadki i asystent" {
        usecase "Wywołaj scenariusz krakowski" as UC_Scenario
        usecase "Wygeneruj rekomendację" as UC_GenRec
        usecase "Zatwierdź rekomendację" as UC_Approve
        usecase "Odrzuć rekomendację" as UC_Reject
        usecase "Cofnij decyzję" as UC_Undo
    }

    package "Ocena i analityka" {
        usecase "Przeglądaj nastroje dzielnic" as UC_Districts
        usecase "Czytaj Spotted: MPK Kraków" as UC_Spotted
        usecase "Przeglądaj wykresy słupkowe" as UC_Bars
        usecase "Zapisz grę" as UC_Save
        usecase "Wczytaj grę" as UC_Load
    }
}

Dyspozytor --> UC_Preview
Dyspozytor --> UC_BuildStop
Dyspozytor --> UC_CreateRoute
Dyspozytor --> UC_BuyVehicle
Dyspozytor --> UC_Budget
Dyspozytor --> UC_Recruit
Dyspozytor --> UC_DriverCard
Dyspozytor --> UC_Speed
Dyspozytor --> UC_LiveMap
Dyspozytor --> UC_Scenario
Dyspozytor --> UC_Approve
Dyspozytor --> UC_Reject
Dyspozytor --> UC_Undo
Dyspozytor --> UC_Districts
Dyspozytor --> UC_Spotted
Dyspozytor --> UC_Bars
Dyspozytor --> UC_Save
Dyspozytor --> UC_Load

Asystent --> UC_GenRec
Zegar --> UC_Tick

UC_CreateRoute .> UC_FindPath : <<include>>
UC_CreateTempRoute .> UC_CreateRoute : <<extend>>
UC_BuildStop .> UC_Budget : <<include>>
UC_BuyVehicle .> UC_Budget : <<include>>
UC_Tick .> UC_Tachograph : <<include>>
UC_Scenario .> UC_GenRec : <<include>>
UC_Approve .> UC_CreateTempRoute : <<extend>>
UC_Undo .> UC_Approve : <<extend>>

@enduml
